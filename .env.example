# 이 파일을 .env로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# 이 파일들은 서버에서만 읽는다. 프론트엔드로 내려보내지 않는다.

# DeepSeek API 키
DEEPSEEK_API_KEY=

# MongoDB 연결 문자열
# 로컬:  mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pw>@<cluster>/...
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=agreed

# 프론트엔드 주소 (CORS 허용 대상)
FRONTEND_ORIGIN=http://localhost:3000
