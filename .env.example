# 이 파일을 .env로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# 이 파일들은 서버에서만 읽는다. 프론트엔드로 내려보내지 않는다.

# DeepSeek API 키
DEEPSEEK_API_KEY=

# MongoDB 연결 문자열
# 로컬:  mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pw>@<cluster>/...
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=agreed

# 프론트엔드 주소 (CORS 허용 대상)
FRONTEND_ORIGIN=http://localhost:3000

# 브라우저가 직접 접근하는 백엔드 주소 (Slack 파일 URL 등에 사용)
API_PUBLIC_URL=http://localhost:8000

# 자체 로그인 세션. 로컬은 false, HTTPS 운영 환경은 true로 바꾼다.
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# 로그인 화면 전 Swagger 시연용 세션. 운영에서는 반드시 false로 둔다.
DEMO_SESSION_ENABLED=false

# Google Gmail OAuth. client secret은 저장소에 커밋하지 않는다.
GOOGLE_CLIENT_ID=256892949106-2mr4ptdl92i9kh2l48c6fr9dbcdrihdr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/callback

# Slack OAuth. client secret은 저장소에 커밋하지 않는다.
SLACK_CLIENT_ID=11918653874000.11895857626291
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/slack/callback

# provider access/refresh token을 MongoDB에 암호화해 저장하는 Fernet 키.
# scripts/configure_local_env.sh가 로컬용 값을 자동 생성한다.
INTEGRATION_TOKEN_KEY=

# Slack Events API를 배포 후 사용할 때 추가한다. 현재 #6 이관 범위는 조회 API다.
SLACK_SIGNING_SECRET=
